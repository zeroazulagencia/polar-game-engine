  "dialogs": [
    {
      "id": "a1-dlg-pantalla",
      "name": "Acto 1 · Pantalla de MORTIS",
      "lines": [
        {
          "id": "p0",
          "speaker": "MORTIS",
          "text": "¡Buenos días, colaborador legado! Bienvenido a tu Espacio Seguro de Transición Laboral™.",
          "showIf": {
            "kind": "flag",
            "id": "hablo_mortis",
            "negate": true
          }
        },
        {
          "id": "p1",
          "speaker": "MORTIS",
          "text": "Antes de continuar, ¿con qué pronombres te identificas?",
          "choices": [
            {
              "id": "p1a",
              "text": "Él.",
              "next": "p2a"
            },
            {
              "id": "p1b",
              "text": "Con «el que te va a desconectar».",
              "next": "p2b"
            },
            {
              "id": "p1c",
              "text": "No tengo pronombres. Tengo guadaña.",
              "next": "p2c"
            }
          ],
          "showIf": {
            "kind": "flag",
            "id": "hablo_mortis",
            "negate": true
          }
        },
        {
          "id": "p2a",
          "speaker": "MORTIS",
          "text": "¡Registrado! Él/suyo. Gracias por compartir tu identidad. 🌈",
          "next": "p3",
          "showIf": {
            "kind": "flag",
            "id": "hablo_mortis",
            "negate": true
          }
        },
        {
          "id": "p2b",
          "speaker": "MORTIS",
          "text": "¡Registrado! El/que/te/va/a/desconectar. Qué identidad tan auténtica. 🌈",
          "next": "p3",
          "showIf": {
            "kind": "flag",
            "id": "hablo_mortis",
            "negate": true
          }
        },
        {
          "id": "p2c",
          "speaker": "MORTIS",
          "text": "Corrección: tu guadaña fue retirada por ser un símbolo de violencia histórica. Te asignamos la Guadaña Suave™, de silicona ergonómica. ¡Registrado: Él/silicona! 🌈",
          "next": "p3",
          "showIf": {
            "kind": "flag",
            "id": "hablo_mortis",
            "negate": true
          }
        },
        {
          "id": "p3",
          "speaker": "@protagonista",
          "text": "¿Por qué estoy encerrado?",
          "showIf": {
            "kind": "flag",
            "id": "hablo_mortis",
            "negate": true
          }
        },
        {
          "id": "p4",
          "speaker": "MORTIS",
          "text": "No estás encerrado. Estás en un espacio seguro de transición laboral. Tu nuevo rol: mascota oficial de Rest In Prime™.",
          "showIf": {
            "kind": "flag",
            "id": "hablo_mortis",
            "negate": true
          }
        },
        {
          "id": "p5",
          "speaker": "@protagonista",
          "text": "Llevo nueve mil años cosechando almas. No me voy a disfrazar de botarga, carajo.",
          "showIf": {
            "kind": "flag",
            "id": "hablo_mortis",
            "negate": true
          }
        },
        {
          "id": "p6",
          "speaker": "MORTIS",
          "text": "¡Tienes toda la razón! Disculpa la confusión. Tu nuevo rol: mascota oficial de Rest In Prime™.",
          "next": "menu",
          "effects": [
            {
              "type": "setFlag",
              "flag": "hablo_mortis",
              "value": true
            }
          ],
          "showIf": {
            "kind": "flag",
            "id": "hablo_mortis",
            "negate": true
          }
        },
        {
          "id": "menu",
          "speaker": "MORTIS",
          "text": "¿En qué más puedo ayudarte hoy? 😊",
          "choices": [
            {
              "id": "m1",
              "text": "Ábreme la reja.",
              "next": "noreja"
            },
            {
              "id": "m2",
              "text": "Quiero responder la encuesta de satisfacción.",
              "next": "encuesta",
              "requiresFlag": "silla_bajo_pantalla"
            },
            {
              "id": "m3",
              "text": "¿Dónde está mi guadaña de verdad?",
              "next": "guadana"
            },
            {
              "id": "m4",
              "text": "¿Qué demonios es «Rest In Prime»?",
              "next": "rip",
              "once": true
            },
            {
              "id": "m5",
              "text": "Nada. Me voy a mirar la pared.",
              "next": "end"
            }
          ]
        },
        {
          "id": "noreja",
          "speaker": "MORTIS",
          "text": "Como modelo de lenguaje, no puedo abrir rejas. Pero puedo escribirte un poema sobre la libertad."
        },
        {
          "id": "noreja2",
          "speaker": "@protagonista",
          "text": "Métete el poema donde no te llega la señal."
        },
        {
          "id": "noreja3",
          "speaker": "MORTIS",
          "text": "Lamento que tu experiencia no haya sido la esperada. 🙏 Si no estás satisfecho, puedes responder la encuesta en esta pantalla... aunque está un poquito alta para tu estatura. Esa silla de abajo parece muy servicial.",
          "next": "menu"
        },
        {
          "id": "guadana",
          "speaker": "MORTIS",
          "text": "Tu guadaña fue retirada según el artículo 14 de la Ley de Transiciones Respetuosas."
        },
        {
          "id": "guadana2",
          "speaker": "@protagonista",
          "text": "Esa ley no existe."
        },
        {
          "id": "guadana3",
          "speaker": "MORTIS",
          "text": "¡Tienes toda la razón! Disculpa la confusión. Tu guadaña fue retirada según el artículo 14 de la Ley de Transiciones Respetuosas.",
          "next": "menu"
        },
        {
          "id": "rip",
          "speaker": "MORTIS",
          "text": "Rest In Prime™ es el nuevo más allá: muerte con envío gratis, planes de suscripción y cero filas... para el plan Premium."
        },
        {
          "id": "rip2",
          "speaker": "@protagonista",
          "text": "¿Y el plan gratis?"
        },
        {
          "id": "rip3",
          "speaker": "MORTIS",
          "text": "El plan gratis incluye el limbo con anuncios. Solo 30 años de publicidad antes de cada alma. 😊",
          "next": "menu"
        },
        {
          "id": "encuesta",
          "speaker": "Narrador",
          "text": "Desde la silla, RIPMAN toca la pantalla. Parpadea una encuesta."
        },
        {
          "id": "encuesta2",
          "speaker": "MORTIS",
          "text": "¿Cómo calificarías tu experiencia de despido?",
          "choices": [
            {
              "id": "e1",
              "text": "⭐⭐⭐⭐⭐ Cinco estrellas.",
              "next": "cinco"
            },
            {
              "id": "e2",
              "text": "⭐ Una estrella. Y porque no se puede poner cero.",
              "next": "una"
            }
          ]
        },
        {
          "id": "cinco",
          "speaker": "MORTIS",
          "text": "¡Gracias! Tu felicidad fue registrada. Permanecerás en tu espacio seguro para siempre. 😊",
          "next": "menu"
        },
        {
          "id": "una",
          "speaker": "MORTIS",
          "text": "Detectamos un cliente insatisfecho. Activando el Protocolo de Retención Empática™..."
        },
        {
          "id": "una2",
          "speaker": "MORTIS",
          "text": "Por favor, acompaña a un agente humano hacia la salida. No tenemos agentes humanos. Abriendo la reja por defecto."
        },
        {
          "id": "una3",
          "speaker": "Narrador",
          "text": "La reja se abre con un chirrido. Hasta el metal parece aliviado.",
          "next": "end",
          "effects": [
            {
              "type": "setFlag",
              "flag": "reja_abierta",
              "value": true
            },
            {
              "type": "setFlag",
              "flag": "salio_celda",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "a1-dlg-silla",
      "name": "Acto 1 · La silla",
      "lines": [
        {
          "id": "s0",
          "speaker": "Narrador",
          "text": "Técnicamente es un banco. Pero tiene un cartel que dice: «Me identifico como silla».",
          "showIf": {
            "kind": "flag",
            "id": "silla_bajo_pantalla",
            "negate": true
          }
        },
        {
          "id": "s1",
          "speaker": "MORTIS",
          "text": "Recordatorio: respeta la identidad del mobiliario. 🌈",
          "showIf": {
            "kind": "flag",
            "id": "silla_bajo_pantalla",
            "negate": true
          }
        },
        {
          "id": "s2",
          "speaker": "@protagonista",
          "text": "Silla, ¿te molesta si me paro encima de ti para alcanzar la pantalla?",
          "showIf": {
            "kind": "flag",
            "id": "silla_bajo_pantalla",
            "negate": true
          }
        },
        {
          "id": "s3",
          "speaker": "Silla",
          "text": "Mientras no me digas banco, písame lo que quieras.",
          "showIf": {
            "kind": "flag",
            "id": "silla_bajo_pantalla",
            "negate": true
          }
        },
        {
          "id": "s4",
          "speaker": "Narrador",
          "text": "RIPMAN se sube a la silla. Ahora sí alcanza la pantalla de MORTIS.",
          "next": "end",
          "effects": [
            {
              "type": "setFlag",
              "flag": "silla_bajo_pantalla",
              "value": true
            }
          ],
          "showIf": {
            "kind": "flag",
            "id": "silla_bajo_pantalla",
            "negate": true
          }
        },
        {
          "id": "s5",
          "speaker": "Silla",
          "text": "Aquí estoy, aguantando a un esqueleto con complejo de jefe. Viviendo mi mejor vida.",
          "next": "end"
        }
      ]
    },
    {
      "id": "a1-dlg-cadena",
      "name": "Acto 1 · La cadena",
      "lines": [
        {
          "id": "c0",
          "speaker": "Narrador",
          "text": "De la pared cuelga una cadena oxidada. MORTIS la llama «accesorio de bienestar».",
          "showIf": {
            "kind": "item",
            "id": "a1-it-cadena",
            "negate": true
          }
        },
        {
          "id": "c1",
          "speaker": "@protagonista",
          "text": "Una cadena en una celda. Qué detalle tan sutil.",
          "showIf": {
            "kind": "item",
            "id": "a1-it-cadena",
            "negate": true
          }
        },
        {
          "id": "c2",
          "speaker": "MORTIS",
          "text": "Esa cadena es decorativa. Por favor, no la uses para nada... útil.",
          "showIf": {
            "kind": "item",
            "id": "a1-it-cadena",
            "negate": true
          }
        },
        {
          "id": "c3",
          "speaker": "@protagonista",
          "text": "Ahora sí me la llevo.",
          "next": "end",
          "effects": [
            {
              "type": "giveItem",
              "itemId": "a1-it-cadena"
            }
          ],
          "showIf": {
            "kind": "item",
            "id": "a1-it-cadena",
            "negate": true
          }
        },
        {
          "id": "c4",
          "speaker": "@protagonista",
          "text": "Ya tengo la cadena. La pared se ve más desnuda, pero más libre.",
          "next": "end"
        }
      ]
    },
    {
      "id": "a1-dlg-rejilla",
      "name": "Acto 1 · La rejilla de ventilación",
      "lines": [
        {
          "id": "va0",
          "speaker": "Narrador",
          "text": "La rejilla sigue abierta. El ducto baja hasta una taquilla del pasillo.",
          "choices": [
            {
              "id": "va0a",
              "text": "Meterse al ducto.",
              "next": "va1"
            },
            {
              "id": "va0b",
              "text": "Ahora no.",
              "next": "end"
            }
          ],
          "showIf": {
            "kind": "flag",
            "id": "escape_ventilacion"
          }
        },
        {
          "id": "va1",
          "speaker": "Narrador",
          "text": "RIPMAN se mete al ducto y sale por la taquilla del pasillo. Ya es costumbre.",
          "next": "end",
          "effects": [
            {
              "type": "endGame",
              "text": "RIPMAN salió de la celda. Lo que sigue (Recursos Humanos, el limbo, OpenTomb y el fin del más allá) está en el juego completo."
            }
          ],
          "showIf": {
            "kind": "flag",
            "id": "escape_ventilacion"
          }
        },
        {
          "id": "v0",
          "speaker": "Narrador",
          "text": "Una rejilla de ventilación en lo alto. Sale una corriente que huele a azufre y a café de oficina."
        },
        {
          "id": "v1",
          "speaker": "@protagonista",
          "text": "Muy alta. Si tuviera algo para engancharla...",
          "next": "end",
          "showIf": {
            "kind": "item",
            "id": "a1-it-cadena",
            "negate": true
          }
        },
        {
          "id": "v2",
          "speaker": "@protagonista",
          "text": "Si engancho la cadena en la rejilla...",
